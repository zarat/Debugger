  <ItemGroup>
    <PackageReference Include="ScriptStack" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AutocompleteMenu">
      <HintPath>AutocompleteMenu.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>